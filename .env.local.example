# Supabase — Project Settings > API хэсгээс аваарай
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx
# Зөвхөн сервер талд ашиглана (RPC/admin үйлдэл) — .env.local-д хадгалаад хэзээ ч client-д бүү дэлгэ
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# Web Push (npx web-push generate-vapid-keys -ээр үүсгэнэ)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sport.mn
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
